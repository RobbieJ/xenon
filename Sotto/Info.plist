<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sotto</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Sotto uses Bluetooth to connect directly to your conversation partner's iPhone when Wi-Fi is off.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sotto connects directly to your conversation partner's iPhone nearby. No internet is used.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sotto sends your voice from your AirPods to the person you are talking with. Nothing is recorded or stored.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sotto can show live captions of what your partner says, processed on this iPhone only.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>WiFiAwareServices</key>
	<dict>
		<key>_sotto._udp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
</dict>
</plist>
